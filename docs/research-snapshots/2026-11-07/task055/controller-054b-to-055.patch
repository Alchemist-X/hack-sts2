+    @staticmethod
+    def _longitudinal_results(db, experiment, spec):
+        """Earlier accepted dev evaluations of the same frozen experiment."""
+        rows = db.execute(
+            """SELECT e.id AS event_id,e.payload,j.id AS job_id,j.payload AS job_payload,j.outcome
+               FROM events e JOIN research_origins o ON o.event_id=e.id
+               JOIN jobs j ON j.id=o.job_id
+               WHERE e.kind='result' AND o.experiment_id=? AND j.experiment_id=?
+               AND j.kind='eval' AND j.state='done' AND j.error IS NULL AND j.outcome IS NOT NULL
+               AND json_extract(e.payload,'$.manifest.identity.config_hash')=?
+               AND json_extract(e.payload,'$.manifest.identity.eval_protocol')=?
+               AND json_extract(e.payload,'$.manifest.identity.dev_seed_manifest_hash')=?
+               AND json_extract(e.payload,'$.manifest.metadata.decisions')<?
+               ORDER BY json_extract(e.payload,'$.manifest.metadata.decisions') DESC,e.rowid DESC LIMIT 8""",
+            (experiment["id"], experiment["id"], experiment["config_hash"], spec["eval_protocol"],
+             spec["dev_seed_manifest_hash"], experiment["decisions"]),
+        )
+        summaries = []
+        for row in rows:
+            result, job_payload, outcome = (json.loads(row[key]) for key in ("payload", "job_payload", "outcome"))
