     @staticmethod
+    def terminal_modal_probe_ids(db):
+        """Release only the nine exact historical proofs under the user opt-in."""
+        if Store.budget_policy_mode(db) != "terminal_modal_history_v1":
+            return ()
+        marks = ",".join("?" for _ in TERMINAL_MODAL_PROBES_056)
+        rows = db.execute(
+            f"""SELECT j.id,j.state,j.reserve,j.actual,j.payload,j.outcome,j.remote_id,
+                       j.submit_started,b.vendor FROM jobs j
+                 LEFT JOIN job_billing b ON b.job_id=j.id WHERE j.id IN ({marks})""",
+            tuple(TERMINAL_MODAL_PROBES_056),
+        ).fetchall()
+        released = []
+        for row in rows:
+            category, status, reserve, report_ref, report_sha = TERMINAL_MODAL_PROBES_056[row["id"]]
+            if (row["state"] != "external_finished_cost_unknown" or row["actual"] is not None
+                    or row["reserve"] != reserve or row["vendor"] != "modal" or not row["outcome"]):
+                continue
+            try:
+                payload, outcome = json.loads(row["payload"]), json.loads(row["outcome"])
+                details = outcome.get("details", {})
+                if (payload.get("category") != category or outcome.get("status") != status
+                        or outcome.get("report_ref") != report_ref or details.get("report_sha256") != report_sha):
+                    continue
+                if category == "gpu_smoke":
+                    exit_code = details.get("provider_exit_code")
+                    if (row["submit_started"] != 1 or not row["remote_id"]
+                            or details.get("sandbox_id") != row["remote_id"] or type(exit_code) is not int
+                            or (status == "gpu_verified") != (exit_code == 0)):
+                        continue
+                elif category == "runtime_gpu_acceptance":
+                    children = details.get("child_receipts")
+                    approved = payload.get("authorized_jobs")
+                    if (type(children) is not list or type(approved) is not list or len(children) != 4
+                            or [child.get("job_id") for child in children] != approved
+                            or len({child.get("sandbox_id") for child in children}) != 4
+                            or any(type(child.get("provider_exit_code")) is not int
+                                   or child["provider_exit_code"] != 0
+                                   or not isinstance(child.get("sandbox_id"), str)
+                                   or not child["sandbox_id"].startswith("sb-") for child in children)):
+                        continue
+                elif row["id"] == "reservation_runtime_cpu_012":
+                    if details.get("sandbox_creates") != 0 or details.get("unit_inactive") is not True:
+                        continue
+                elif row["id"] == "reservation_runtime_cpu_013":
+                    # The pinned isolated acceptance report contains the three
+                    # finished CPU child receipts; they are not in this live DB.
+                    if (details.get("cpu_sandboxes") != 3 or details.get("gpu_sandboxes") != 0
+                            or details.get("model_calls") != 0 or
+                            len({details.get("stopped_id"), details.get("resumed_id"),
+                                 details.get("lost_receipt_same_id")}) != 3):
+                        continue
+            except (TypeError, ValueError, KeyError, AttributeError):
+                continue
+            released.append(row["id"])
+        return tuple(sorted(released))
