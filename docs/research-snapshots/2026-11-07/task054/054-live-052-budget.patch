+def _claim_resume_s_054_request():
+    if RESUME_S_054_CLAIM.exists() or RESUME_S_054_CLAIM.is_symlink():
+        return False
+    if not RESUME_S_054_REQUEST.exists() and not RESUME_S_054_REQUEST.is_symlink():
+        return False
