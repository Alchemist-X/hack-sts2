+        store.append_event(db, RESUME_S_054_EVENT, "operator_budget_override", {
+            "reference": RESUME_S_054_REFERENCE,
+            "policy": "terminal_modal_history_v1",
+            "previous_stop_sha256": RESUME_S_054_STOP_SHA,
