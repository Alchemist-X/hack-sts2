+    folder = parent.stat()
+    if (os.geteuid() != 0 or parent.resolve() != parent or folder.st_uid != 0
+            or stat.S_IMODE(folder.st_mode) != 0o700 or not stat.S_ISREG(metadata.st_mode)
+            or metadata.st_uid != 0 or stat.S_IMODE(metadata.st_mode) != 0o600
+            or RESUME_S_054_REQUEST.read_bytes() != RESUME_S_054_MARKER):
+        raise ValueError("054 root-only request marker differs")
+    os.link(RESUME_S_054_REQUEST, RESUME_S_054_CLAIM)
+    RESUME_S_054_REQUEST.unlink()
+    return True
