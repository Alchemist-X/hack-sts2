+            "experiment_id": RESUME_S_054_EXPERIMENT,
+            "target_decisions": RESUME_S_054_TARGET,
+            "checkpoint": RESUME_S_054_CHECKPOINT,
+            "workspace_observed_at": observed,
+            "workspace_gross_used_cents": snapshot["gross_used"],
+            "workspace_net_spent_cents": snapshot["net_spent"],
