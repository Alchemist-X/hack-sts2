+    private static Dictionary<string, object?> BuildEvalMeta()
+    {
+        var meta = new Dictionary<string, object?>
+        {
+            ["harness_only"] = true,
+            ["note"] = "Strip eval_meta before showing state to a policy: rng counters are not visible to a human player.",
