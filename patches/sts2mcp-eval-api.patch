+            ["acts"] = run.Acts.Select(a => a.Id.Entry).ToList(),
+            ["floor"] = run.TotalFloor,
+            ["act_floor"] = run.ActFloor,
+            ["map_coord"] = coord == null ? null : new Dictionary<string, object?> { ["col"] = coord.Value.col, ["row"] = coord.Value.row },
+            ["room"] = run.CurrentRoom?.GetType().Name,
+            ["is_game_over"] = run.IsGameOver,
+            ["run_time_s"] = rm.RunTime,
+            ["hp"] = player?.Creature?.CurrentHp,
+            ["max_hp"] = player?.Creature?.MaxHp,
+            ["gold"] = player?.Gold,
+        };
+    }
