+    private static readonly object EvalLock = new();
+    private static readonly SemaphoreSlim EvalLongOp = new(1, 1);
+    private static long _evalStateVersion;
+    private static string? _evalLastFingerprint;
+    private static Dictionary<string, object?>? _lastRunResult;
+    private static string? _lastRunResultKey;
+    private static readonly Dictionary<string, object?> _evalSettingsApplied = new();
+    private static bool _evalEnvSettingsApplied;
+    private static readonly Dictionary<string, string> EvalCheckpoints = new();
+    private static Task? _evalSaveTask;
