+    private sealed class EvalProbe
+    {
+        public Dictionary<string, object?> Snapshot = new();
+        public string Fingerprint = "";
+        public bool Busy;
+        public string BusyReason = "";
+    }
+
+    private static EvalProbe BuildEvalProbe(bool includeState)
+    {
+        var probe = new EvalProbe();
+        Dictionary<string, object?> state;
+        try { state = BuildGameState(); }
+        catch (Exception ex)
+        {
+            state = new Dictionary<string, object?> { ["state_type"] = "unknown", ["error"] = $"state build failed: {ex.Message}" };
+        }
+
+        var refs = AnnotateStableRefs(state);
+        var stateForHash = state.Where(kv => kv.Key != "execution").ToDictionary(kv => kv.Key, kv => kv.Value);
+        string json = JsonSerializer.Serialize(stateForHash, _jsonOptions);
+        probe.Fingerprint = Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(json))).ToLowerInvariant()[..16];
+        (probe.Busy, probe.BusyReason) = EvalBusy(state);
+
+        long version;
+        lock (EvalLock)
+        {
+            if (_evalLastFingerprint != probe.Fingerprint)
+            {
+                _evalLastFingerprint = probe.Fingerprint;
+                _evalStateVersion++;
+            }
+            version = _evalStateVersion;
+        }
+
+        var runResult = TryCaptureRunResult();
+        var snap = new Dictionary<string, object?>
+        {
+            ["schema"] = "sts2-eval-snapshot",
+            ["schema_version"] = EvalSchemaVersion,
+            ["state_version"] = version,
+            ["state_fingerprint"] = probe.Fingerprint,
+            ["state_type"] = state.TryGetValue("state_type", out var st) ? st : null,
+            ["busy"] = probe.Busy,
+            ["busy_reason"] = probe.Busy ? probe.BusyReason : null,
+            ["run"] = BuildEvalRunInfo(),
+            ["pending_epoch_ids"] = SafePendingEpochs(),
+            ["refs"] = refs,
+            ["run_result"] = runResult ?? (RunManager.Instance.IsInProgress ? null : _lastRunResult),
+            ["eval_meta"] = BuildEvalMeta(),
+        };
+        if (includeState) snap["state"] = state;
+        probe.Snapshot = snap;
+        return probe;
+    }
+
+    private static (bool, string) EvalBusy(Dictionary<string, object?> state)
+    {
+        var game = NGame.Instance;
+        if (game?.Transition != null && game.Transition.InTransition) return (true, "scene_transition");
+        if (SaveManager.Instance?.CurrentRunSaveTask != null) return (true, "run_save_in_progress");
+        if (_evalSaveTask != null && !_evalSaveTask.IsCompleted) return (true, "checkpoint_write_in_progress");
+        if (!RunManager.Instance.IsInProgress) return (false, "");
+        if (NRun.Instance == null) return (true, "run_scene_loading");
+        var queues = RunManager.Instance.ActionQueueSet;
+        var executor = RunManager.Instance.ActionExecutor;
+        if (queues != null && !queues.IsEmpty) return (true, "action_queue_not_empty");
+        if (executor != null && (executor.IsRunning || executor.CurrentlyRunningAction != null)) return (true, "action_executing");
+        string stateType = state.TryGetValue("state_type", out var st) ? st as string ?? "" : "";
+        // Between the last enemy dying and the rewards screen the state builder reports the
+        // combat room with only "Combat ended. Waiting for rewards..." and nothing actionable.
+        if (stateType is "monster" or "elite" or "boss" && !state.ContainsKey("battle"))
+            return (true, "combat_ending_awaiting_rewards");
+        if (CombatManager.Instance.IsInProgress && stateType is "monster" or "elite" or "boss")
+        {
+            var run = RunManager.Instance.DebugOnlyGetState();
+            var player = run == null ? null : LocalContext.GetMe(run);
+            var pc = player?.PlayerCombatState;
+            var manager = CombatManager.Instance;
+            var hand = NCombatRoom.Instance?.Ui?.Hand;
+            if (player == null || pc == null) return (true, "combat_player_missing");
+            if (pc.Phase != PlayerTurnPhase.Play) return (true, $"combat_phase_{pc.Phase}");
+            if (manager.PlayerActionsDisabled || manager.EndingPlayerTurnPhaseOne || manager.EndingPlayerTurnPhaseTwo)
+                return (true, "combat_player_actions_disabled");
+            if (manager.IsExecutingCardOrPotionEffect(player)) return (true, "combat_effect_executing");
+            if (hand != null && hand.InCardPlay) return (true, "combat_card_in_play");
+        }
+        return (false, "");
+    }
+
+    /// <summary>
+    /// Polls snapshots until the state is not busy and its fingerprint has been unchanged
+    /// for stable_ms. waitMs=0 returns one immediate snapshot.
+    /// </summary>
+    private static Dictionary<string, object?> EvalWaitSettled(int waitMs, int stableMs, bool includeState)
+    {
+        EnsureEnvSettingsApplied();
+        var start = DateTime.UtcNow;
+        var deadline = start.AddMilliseconds(waitMs);
+        string? lastFp = null;
+        DateTime lastChange = start;
+        EvalProbe probe;
+        while (true)
+        {
+            probe = OnMain(() => BuildEvalProbe(includeState));
+            var now = DateTime.UtcNow;
+            if (probe.Fingerprint != lastFp) { lastFp = probe.Fingerprint; lastChange = now; }
+            bool stable = waitMs == 0 || (now - lastChange).TotalMilliseconds >= stableMs;
+            if (!probe.Busy && stable)
+            {
+                probe.Snapshot["settled"] = true;
+                break;
+            }
+            if (now >= deadline)
+            {
+                probe.Snapshot["settled"] = false;
+                probe.Snapshot["settle_timeout"] = waitMs > 0;
+                break;
+            }
+            Thread.Sleep(50);
+        }
+        probe.Snapshot["waited_ms"] = (int)(DateTime.UtcNow - start).TotalMilliseconds;
+        return probe.Snapshot;
+    }
+
