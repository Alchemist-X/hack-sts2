+    private static void HandleEvalRequest(HttpListenerRequest request, HttpListenerResponse response)
+    {
+        if (IsMultiplayerRun())
+        {
+            SendError(response, 409, "Eval API is singleplayer-only; a multiplayer run is active.");
+            return;
+        }
+        if (request.HttpMethod == "GET")
+        {
+            int waitMs = ParseQueryInt(request, "wait_settled_ms", 0, 0, 120000);
+            int stableMs = ParseQueryInt(request, "stable_ms", 200, 0, 5000);
+            bool includeState = request.QueryString["include_state"] != "false";
+            try { SendJson(response, EvalWaitSettled(waitMs, stableMs, includeState)); }
+            catch (Exception ex) { SendError(response, 500, $"Eval snapshot failed: {ex.Message}"); }
+            return;
+        }
+        if (request.HttpMethod != "POST")
+        {
+            SendError(response, 405, "Method not allowed");
+            return;
+        }
+
+        string body;
+        using (var reader = new StreamReader(request.InputStream, request.ContentEncoding))
+            body = reader.ReadToEnd();
+        Dictionary<string, JsonElement>? data;
+        try { data = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(body); }
+        catch { SendError(response, 400, "Invalid JSON"); return; }
+        if (data == null || !data.TryGetValue("action", out var actionElem) || actionElem.ValueKind != JsonValueKind.String)
+        {
+            SendError(response, 400, "Missing 'action' field");
+            return;
+        }
+        string action = actionElem.GetString() ?? "";
+        try
+        {
+            SendJson(response, ExecuteEvalAction(action, data));
+        }
+        catch (Exception ex)
+        {
+            GD.PrintErr($"[STS2 MCP] eval {action}: {ex}");
+            SendError(response, 500, $"Eval action '{action}' failed: {ex.GetType().Name}: {ex.Message}");
+        }
+    }
+
+    private static Dictionary<string, object?> ExecuteEvalAction(string action, Dictionary<string, JsonElement> data)
+    {
+        EnsureEnvSettingsApplied();
+        switch (action)
+        {
+            case "snapshot":
+                return EvalWaitSettled(GetInt(data, "wait_settled_ms", 0, 0, 120000), GetInt(data, "stable_ms", 200, 0, 5000), GetBool(data, "include_state", true));
+            case "configure":
+                return OnMain(() => ApplyEvalSettings(data));
+            case "start_run":
+                return WithLongOp(() => EvalStartRun(data));
+            case "abandon":
+                return WithLongOp(() => EvalAbandon(data));
+            case "return_to_menu":
+                return WithLongOp(() => EvalReturnToMenu(GetInt(data, "timeout_ms", 30000, 1000, 120000)));
+            case "run_result":
+                return OnMain(() =>
+                {
+                    var result = TryCaptureRunResult();
+                    if (result == null && RunManager.Instance.IsInProgress)
+                        return new Dictionary<string, object?>
+                        {
+                            // Never hand back an earlier run's summary while a new run is still being played.
+                            ["status"] = "in_progress",
+                            ["error"] = "The current run is not over yet (abandon it to get an abandoned result)",
+                            ["run_result"] = null
+                        };
+                    result ??= _lastRunResult;
+                    return new Dictionary<string, object?>
+                    {
+                        ["status"] = result == null ? "error" : "ok",
+                        ["error"] = result == null ? "No finished run recorded since the game started" : null,
+                        ["run_result"] = result
+                    };
+                });
+            case "checkpoint_save":
+                return WithLongOp(() => EvalCheckpointSave(data));
+            case "checkpoint_restore":
+                return WithLongOp(() => EvalCheckpointRestore(data));
+            case "checkpoint_list":
+                return OnMain(EvalCheckpointList);
+            case "act":
+                return WithLongOp(() => EvalBatch(new List<Dictionary<string, JsonElement>> { data }, data, singleStep: true));
+            case "batch":
+            {
+                if (!data.TryGetValue("steps", out var stepsElem) || stepsElem.ValueKind != JsonValueKind.Array)
+                    return Error("batch requires 'steps': [ {action: ...}, ... ]");
+                var steps = new List<Dictionary<string, JsonElement>>();
+                foreach (var s in stepsElem.EnumerateArray())
+                {
+                    if (s.ValueKind != JsonValueKind.Object) return Error("batch step is not an object");
+                    steps.Add(JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(s.GetRawText())!);
+                }
+                return WithLongOp(() => EvalBatch(steps, data, singleStep: false));
+            }
+            default:
+                return Error($"Unknown eval action: {action}. Use: snapshot, configure, start_run, abandon, return_to_menu, run_result, checkpoint_save, checkpoint_restore, checkpoint_list, act, batch");
+        }
+    }
+
+    private static Dictionary<string, object?> WithLongOp(Func<Dictionary<string, object?>> op)
+    {
+        if (!EvalLongOp.Wait(0))
+            return Error("Another eval operation is in progress on this instance");
+        try { return op(); }
+        finally { EvalLongOp.Release(); }
+    }
+
+    private static T OnMain<T>(Func<T> func) => RunOnMainThread(func).GetAwaiter().GetResult();
