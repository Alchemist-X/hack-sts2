+    private static Dictionary<string, object?>? TryCaptureRunResult()
+    {
+        var rm = RunManager.Instance;
+        var run = rm.DebugOnlyGetState();
+        if (run == null || !run.IsGameOver) return null;
+        var player = LocalContext.GetMe(run);
+        var history = rm.History;
+        string key = $"{run.Rng?.StringSeed}|{rm.GetHashCode()}|{run.GetHashCode()}";
+        if (_lastRunResultKey == key && _lastRunResult != null) return _lastRunResult;
+
+        var tree = Engine.GetMainLoop() as SceneTree;
+        NGameOverScreen? screen = NOverlayStack.Instance?.Peek() as NGameOverScreen;
+        if (screen == null && tree?.Root != null) screen = FindAll<NGameOverScreen>(tree.Root).FirstOrDefault(IsNodeVisible);
+
+        bool victory = history?.Win ?? false;
+        bool abandoned = rm.IsAbandoned || (history?.WasAbandoned ?? false);
+        string cause;
+        if (abandoned) cause = "abandoned";
+        else if (victory) cause = "victory";
+        else if (history != null && history.KilledByEncounter != ModelId.none) cause = $"encounter:{history.KilledByEncounter.Entry}";
+        else if (history != null && history.KilledByEvent != ModelId.none) cause = $"event:{history.KilledByEvent.Entry}";
+        else cause = $"room:{run.CurrentRoom?.GetType().Name}";
+
+        object? score = null;
+        if (screen != null && GetInstanceFieldValue(screen, "_score") is int s && s != 0) score = s;
+        if (score == null) { try { score = ScoreUtility.CalculateScore(run, victory); } catch { } }
+
+        var result = new Dictionary<string, object?>
+        {
+            ["schema"] = "sts2-run-result",
+            ["schema_version"] = EvalSchemaVersion,
+            ["victory"] = victory,
+            ["abandoned"] = abandoned,
+            ["cause"] = cause,
+            ["score"] = score,
+            ["character"] = player?.Character?.Id.Entry,
+            ["seed"] = run.Rng?.StringSeed,
+            ["ascension"] = run.AscensionLevel,
+            ["game_mode"] = run.GameMode.ToString().ToLowerInvariant(),
+            ["modifiers"] = run.Modifiers.Select(DescribeModifier).ToList(),
+            ["act"] = run.CurrentActIndex + 1,
+            ["floor"] = run.TotalFloor,
+            ["act_floor"] = run.ActFloor,
+            ["hp"] = player?.Creature?.CurrentHp,
+            ["max_hp"] = player?.Creature?.MaxHp,
+            ["gold"] = player?.Gold,
+            ["deck"] = player?.Deck.Cards.Select(c => c.Id.Entry + (c.IsUpgraded ? "+" : "")).ToList(),
+            ["relics"] = player?.Relics.Select(r => r.Id.Entry).ToList(),
+            ["potions"] = player?.Potions.Select(p => p.Id.Entry).ToList(),
+            ["run_time_s"] = history?.RunTime ?? (object)rm.RunTime,
+            ["history_available"] = history != null,
+            ["game_over_screen_visible"] = screen != null,
+            ["source"] = "live_run",
+        };
+        // Only cache once the history exists (it is created when the game-over flow runs).
+        if (history != null || screen != null)
+        {
+            _lastRunResult = result;
+            _lastRunResultKey = key;
+            Log.Info($"[STS2 MCP eval] run_result victory={victory} abandoned={abandoned} cause={cause} floor={run.TotalFloor} score={score} seed={run.Rng?.StringSeed} ascension={run.AscensionLevel}");
+        }
+        return result;
+    }
+
+    // Main thread. Summary for a save abandoned from the main menu (no live run state).
+    private static void RecordSavedRunAbandon()
+    {
+        try
+        {
+            var read = SaveManager.Instance.LoadRunSave();
+            if (!read.Success || read.SaveData == null) return;
+            var save = read.SaveData;
+            var info = DescribeSave(save);
+            info["schema"] = "sts2-run-result";
+            info["schema_version"] = EvalSchemaVersion;
+            info["victory"] = false;
+            info["abandoned"] = true;
+            info["cause"] = "abandoned";
+            try { info["score"] = ScoreUtility.CalculateScore(save, false); } catch { info["score"] = null; }
+            info["source"] = "run_save_abandoned_from_menu";
+            _lastRunResult = info;
+            _lastRunResultKey = $"save|{save.SerializableRng?.Seed}|{save.SaveTime}";
+            Log.Info($"[STS2 MCP eval] run_result (saved run abandoned from menu) seed={info["seed"]} ascension={info["ascension"]} floor={info["floor"]}");
+        }
+        catch (Exception ex) { GD.PrintErr($"[STS2 MCP] RecordSavedRunAbandon: {ex.Message}"); }
+    }
+
+    private static Dictionary<string, object?> DescribeSave(SerializableRun save)
+    {
+        return new Dictionary<string, object?>
+        {
+            ["character"] = save.Players.FirstOrDefault()?.CharacterId?.Entry,
+            ["seed"] = save.SerializableRng?.Seed,
+            ["ascension"] = save.Ascension,
+            ["game_mode"] = save.GameMode.ToString().ToLowerInvariant(),
+            ["modifiers"] = save.Modifiers?.Select(m => m.Id?.Entry).Where(id => id != null).ToList() ?? new List<string?>(),
+            ["act"] = save.CurrentActIndex + 1,
+            ["floor"] = SafeSaveFloor(save),
+            ["resume_floor"] = SafeResumeFloor(save),
+            ["num_reloads"] = save.NumReloads,
+            ["save_time"] = save.SaveTime,
+            ["run_time_s"] = save.RunTime,
+            ["pre_finished_room"] = save.PreFinishedRoom != null,
+        };
+    }
+
+    private static object? SafeSaveFloor(SerializableRun save)
+    {
+        try { return save.FloorReached; } catch { return null; }
+    }
+
+    // The autosave is written as a room is entered, before its history entry exists:
+    // floor (history count) lags the floor the game resumes on by one. The room being
+    // resumed is the last visited map coord of the current act.
+    private static object? SafeResumeFloor(SerializableRun save)
+    {
+        try
+        {
+            int previousActs = save.MapPointHistory.Take(save.CurrentActIndex).Sum(c => c.Count);
+            return Math.Max(save.FloorReached, previousActs + save.VisitedMapCoords.Count);
+        }
+        catch { return null; }
+    }
+
+    private static Dictionary<string, object?> EvalAbandon(Dictionary<string, JsonElement> data)
+    {
+        int timeoutMs = GetInt(data, "timeout_ms", 30000, 1000, 120000);
+        bool toMenu = GetBool(data, "return_to_menu", true);
+        var start = DateTime.UtcNow;
+        var deadline = start.AddMilliseconds(timeoutMs);
+        string phase = OnMain(() =>
+        {
+            var rm = RunManager.Instance;
+            if (rm.IsInProgress)
+            {
+                if (rm.IsGameOver) return "already_over";
+                rm.Abandon();
+                return "abandoned_live";
+            }
+            if (SaveManager.Instance.HasRunSave)
+            {
+                var tree = Engine.GetMainLoop() as SceneTree;
+                var mainMenu = tree?.Root == null ? null : FindFirst<NMainMenu>(tree.Root);
+                if (mainMenu == null) return "error:no main menu";
+                mainMenu.RefreshButtons();
+                RecordSavedRunAbandon();
+                mainMenu.AbandonRun();
+                return "abandoned_save";
+            }
+            return "nothing";
+        });
+        if (phase.StartsWith("error:")) return Error(phase[6..]);
+        if (phase == "nothing")
+            return new Dictionary<string, object?> { ["status"] = "ok", ["message"] = "No run in progress and no saved run", ["run_result"] = null };
+
+        Dictionary<string, object?>? result = phase == "abandoned_save" ? _lastRunResult : null;
+        if (phase != "abandoned_save")
+        {
+            while (DateTime.UtcNow < deadline)
+            {
+                var (r, screenVisible) = OnMain(() =>
+                {
+                    var res = TryCaptureRunResult();
+                    return (res, res != null && (bool)(res["game_over_screen_visible"] ?? false));
+                });
+                if (r != null) result = r;
+                if (screenVisible && r != null && (bool)(r["history_available"] ?? false)) break;
+                Thread.Sleep(100);
+            }
+        }
+        Dictionary<string, object?>? menu = null;
+        if (toMenu && phase != "abandoned_save")
+            menu = EvalReturnToMenu(Math.Max(1000, (int)(deadline - DateTime.UtcNow).TotalMilliseconds));
+        return new Dictionary<string, object?>
+        {
+            ["status"] = result != null && (menu == null || (string?)menu["status"] == "ok") ? "ok" : "error",
+            ["error"] = result == null ? "Abandon issued but no run result was captured" : menu?.GetValueOrDefault("error"),
+            ["phase"] = phase,
+            ["run_result"] = result,
+            ["returned_to_menu"] = menu == null ? phase == "abandoned_save" : (string?)menu["status"] == "ok",
+            ["elapsed_ms"] = (int)(DateTime.UtcNow - start).TotalMilliseconds,
+        };
+    }
+
+    private static Dictionary<string, object?> EvalReturnToMenu(int timeoutMs)
+    {
+        var start = DateTime.UtcNow;
+        var deadline = start.AddMilliseconds(timeoutMs);
+        bool issued = false;
+        string how = "none";
+        while (DateTime.UtcNow < deadline)
+        {
+            var status = OnMain(() =>
+            {
+                var tree = Engine.GetMainLoop() as SceneTree;
+                var game = NGame.Instance;
+                bool transitioning = game?.Transition != null && game.Transition.InTransition;
+                if (transitioning) return "wait";
+                var rm = RunManager.Instance;
+                if (!rm.IsInProgress && tree?.Root != null && FindFirst<NMainMenu>(tree.Root) != null) return "done";
+                if (issued) return "wait";
+                if (rm.IsInProgress && rm.IsGameOver)
+                {
+                    TryCaptureRunResult();
+                    var r = ExecuteMenuSelect("main_menu");
+                    if ((string?)r["status"] == "ok") { issued = true; how = "game_over_main_menu"; }
+                    return "wait";
+                }
+                if (rm.IsInProgress && game != null)
+                {
+                    if (SaveManager.Instance.CurrentRunSaveTask != null) return "wait";
+                    TaskHelperRun(game.ReturnToMainMenu());
+                    issued = true;
+                    how = "save_and_quit";
+                    return "wait";
+                }
+                return "wait";
+            });
+            if (status == "done")
+                return new Dictionary<string, object?>
+                {
+                    ["status"] = "ok", ["method"] = how, ["has_saved_run"] = OnMain(SafeHasRunSave),
+                    ["elapsed_ms"] = (int)(DateTime.UtcNow - start).TotalMilliseconds
+                };
+            Thread.Sleep(100);
+        }
+        return new Dictionary<string, object?> { ["status"] = "error", ["error"] = $"Did not reach main menu within {timeoutMs} ms", ["method"] = how };
+    }
+
+    private static void TaskHelperRun(Task task)
+    {
+        task.ContinueWith(t => GD.PrintErr($"[STS2 MCP] eval background task failed: {t.Exception?.GetBaseException().Message}"),
+            TaskContinuationOptions.OnlyOnFaulted);
+    }
+
+    // ------------------------------------------------------------------ checkpoints
+    // A checkpoint is a copy of the game's own run save (current_run.save). The game only
+    // autosaves at room boundaries, so a checkpoint restores the state as of the last
+    // autosave (e.g. map node / room entry), not mid-combat.
+
+    private static string CheckpointDir() => Path.Combine(OS.GetUserDataDir(), "mcp_checkpoints");
+
+    private static bool ValidCheckpointName(string? name) =>
+        !string.IsNullOrEmpty(name) && name.Length <= 64 && name.All(ch => char.IsAsciiLetterOrDigit(ch) || ch == '_' || ch == '-');
+
+    private static Dictionary<string, object?> EvalCheckpointSave(Dictionary<string, JsonElement> data)
+    {
+        string? name = GetString(data, "name");
+        if (!ValidCheckpointName(name)) return Error("checkpoint name must match [A-Za-z0-9_-]{1,64}");
+        int timeoutMs = GetInt(data, "timeout_ms", 15000, 1000, 60000);
+        var deadline = DateTime.UtcNow.AddMilliseconds(timeoutMs);
+        while (OnMain(() => SaveManager.Instance.CurrentRunSaveTask != null))
+        {
+            if (DateTime.UtcNow > deadline) return Error("Timed out waiting for the game's run autosave to finish");
+            Thread.Sleep(50);
+        }
+        var result = OnMain(() =>
+        {
+            if (!SaveManager.Instance.HasRunSave) return Error("No run save exists (start a run and reach the map first)");
+            var read = SaveManager.Instance.LoadRunSave();
+            if (!read.Success || read.SaveData == null) return Error($"Run save could not be read: {read.Status}");
+            string json = JsonSerializationUtility.ToJson(read.SaveData);
+            EvalCheckpoints[name!] = json;
+            var info = DescribeSave(read.SaveData);
+            var live = RunManager.Instance.DebugOnlyGetState();
+            return new Dictionary<string, object?>
+            {
+                ["status"] = "ok",
+                ["name"] = name,
+                ["checkpoint"] = info,
+                ["live_floor"] = live?.TotalFloor,
+                ["matches_live_floor"] = live == null ? null : (object)(Equals(info["resume_floor"], live.TotalFloor)),
+                ["bytes"] = json.Length,
+                ["json"] = json,
+                ["granularity"] = "last game autosave (room boundary); in-room progress since then is not captured",
+            };
+        });
+        if ((string?)result["status"] != "ok") return result;
+        string jsonText = (string)result["json"]!;
+        result.Remove("json");
+        try
+        {
+            Directory.CreateDirectory(CheckpointDir());
+            string path = Path.Combine(CheckpointDir(), name + ".save.json");
+            File.WriteAllText(path, jsonText);
+            result["path"] = path;
+        }
+        catch (Exception ex) { result["file_error"] = ex.Message; }
+        Log.Info($"[STS2 MCP eval] checkpoint_save {name} floor={((Dictionary<string, object?>)result["checkpoint"]!)["floor"]}");
+        return result;
+    }
+
+    private static Dictionary<string, object?> EvalCheckpointList()
+    {
+        var names = new SortedSet<string>(EvalCheckpoints.Keys);
+        try
+        {
+            if (Directory.Exists(CheckpointDir()))
+                foreach (var f in Directory.GetFiles(CheckpointDir(), "*.save.json"))
+                    names.Add(Path.GetFileName(f)[..^".save.json".Length]);
+        }
+        catch { }
+        return new Dictionary<string, object?> { ["status"] = "ok", ["checkpoints"] = names.ToList(), ["dir"] = CheckpointDir() };
+    }
+
+    private static Dictionary<string, object?> EvalCheckpointRestore(Dictionary<string, JsonElement> data)
+    {
+        string? name = GetString(data, "name");
+        if (!ValidCheckpointName(name)) return Error("checkpoint name must match [A-Za-z0-9_-]{1,64}");
+        int timeoutMs = GetInt(data, "timeout_ms", 60000, 5000, 180000);
+        var start = DateTime.UtcNow;
+        var deadline = start.AddMilliseconds(timeoutMs);
+        string? json = null;
+        lock (EvalLock) { EvalCheckpoints.TryGetValue(name!, out json); }
+        if (json == null)
+        {
+            string path = Path.Combine(CheckpointDir(), name + ".save.json");
+            if (!File.Exists(path)) return Error($"Unknown checkpoint '{name}'");
+            json = File.ReadAllText(path);
+        }
+
+        if (OnMain(() => RunManager.Instance.IsInProgress))
+        {
+            var menu = EvalReturnToMenu(Math.Min(30000, timeoutMs));
+            if ((string?)menu["status"] != "ok") return menu;
+        }
+
+        var write = OnMain(() =>
+        {
+            var parsed = JsonSerializationUtility.FromJson<SerializableRun>(json);
+            if (!parsed.Success || parsed.SaveData == null) return Error($"Checkpoint JSON did not parse: {parsed.Status}");
+            var save = parsed.SaveData;
+            save.NumReloads -= 1; // IncrementNumReloads adds it back; it is the game's public run-save writer.
+            _evalSaveTask = SaveManager.Instance.IncrementNumReloads(save, false);
+            return new Dictionary<string, object?> { ["status"] = "ok", ["checkpoint"] = DescribeSave(save) };
+        });
+        if ((string?)write["status"] != "ok") return write;
+        while (true)
+        {
+            var t = _evalSaveTask;
+            if (t == null || t.IsCompleted) break;
+            if (DateTime.UtcNow > deadline) return Error("Timed out writing the run save");
+            Thread.Sleep(50);
+        }
+        if (_evalSaveTask?.IsFaulted == true)
+            return Error($"Writing run save failed: {_evalSaveTask.Exception?.GetBaseException().Message}");
+
+        bool clicked = false;
+        while (DateTime.UtcNow < deadline)
+        {
+            var status = OnMain(() =>
+            {
+                var game = NGame.Instance;
+                if (game?.Transition != null && game.Transition.InTransition) return "wait";
+                if (RunManager.Instance.IsInProgress && NRun.Instance != null) return clicked ? "done" : "wait";
+                if (clicked) return "wait";
+                var tree = Engine.GetMainLoop() as SceneTree;
+                var mainMenu = tree?.Root == null ? null : FindFirst<NMainMenu>(tree.Root);
+                if (mainMenu == null) return "wait";
+                mainMenu.RefreshButtons();
+                var r = ClickMenuButtonField(mainMenu, "_continueButton", "Continue");
+                if ((string?)r["status"] == "ok") clicked = true;
+                return "wait";
+            });
+            if (status == "done") break;
+            Thread.Sleep(120);
+        }
+        if (!OnMain(() => RunManager.Instance.IsInProgress && NRun.Instance != null))
+            return Error($"Run did not load from checkpoint within {timeoutMs} ms");
+
+        OnMain(() => { ResetCardUids(); return true; });
+        var snap = EvalWaitSettled(Math.Max(1000, Math.Min(30000, (int)(deadline - DateTime.UtcNow).TotalMilliseconds)), 300, includeState: false);
+        var readback = OnMain(BuildEvalRunInfo);
+        var expected = (Dictionary<string, object?>)write["checkpoint"]!;
+        var mismatches = new List<string>();
+        foreach (var k in new[] { "seed", "ascension" })
+            if (!Equals(expected[k]?.ToString(), readback.GetValueOrDefault(k)?.ToString()))
+                mismatches.Add($"{k}: checkpoint {expected[k]}, live {readback.GetValueOrDefault(k)}");
+        string liveFloor = readback.GetValueOrDefault("floor")?.ToString() ?? "";
+        if (liveFloor != expected.GetValueOrDefault("resume_floor")?.ToString() && liveFloor != expected.GetValueOrDefault("floor")?.ToString())
+            mismatches.Add($"floor: checkpoint resume_floor {expected.GetValueOrDefault("resume_floor")}, live {liveFloor}");
+        Log.Info($"[STS2 MCP eval] checkpoint_restore {name} verified={mismatches.Count == 0}");
+        return new Dictionary<string, object?>
+        {
+            ["status"] = mismatches.Count == 0 ? "ok" : "error",
+            ["error"] = mismatches.Count == 0 ? null : "Restored run does not match checkpoint: " + string.Join("; ", mismatches),
+            ["name"] = name,
+            ["checkpoint"] = expected,
+            ["readback"] = readback,
+            ["state_version"] = snap["state_version"],
+            ["state_type"] = snap["state_type"],
+            ["settled"] = snap["settled"],
+            ["elapsed_ms"] = (int)(DateTime.UtcNow - start).TotalMilliseconds,
+            ["note"] = "Restores the run save; the game rebuilds the room from it. RNG counters are restored from the save, so the continuation is deterministic given the same actions.",
+        };
+    }
+
+    // ------------------------------------------------------------------ batch
+
+    private static Dictionary<string, object?> EvalBatch(List<Dictionary<string, JsonElement>> steps, Dictionary<string, JsonElement> options, bool singleStep)
+    {
+        if (steps.Count == 0) return Error("No steps");
+        if (steps.Count > 50) return Error("At most 50 steps per batch");
+        int waitMs = GetInt(options, "wait_settled_ms", 15000, 0, 120000);
+        int stableMs = GetInt(options, "stable_ms", 200, 0, 5000);
+        bool stopOnNoChange = GetBool(options, "stop_on_no_change", true);
+        bool includeState = GetBool(options, "include_state", true);
+
+        var results = new List<Dictionary<string, object?>>();
+        var current = EvalWaitSettled(Math.Min(waitMs, 5000), stableMs, includeState: false);
+        string stopReason = "completed";
+        for (int i = 0; i < steps.Count; i++)
+        {
+            var step = steps[i];
+            Dictionary<string, JsonElement> action = step;
+            if (singleStep)
+            {
+                if (!step.TryGetValue("game_action", out var ga) || ga.ValueKind != JsonValueKind.Object)
+                    return Error("act requires 'game_action': {action: ..., ...} (the /api/v1/singleplayer POST body)");
+                action = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(ga.GetRawText())!;
+            }
+            string? name = GetString(action, "action");
+            var entry = new Dictionary<string, object?>
+            {
+                ["index"] = i, ["action"] = name,
+                ["state_version_before"] = current["state_version"], ["state_type_before"] = current["state_type"],
+            };
+            results.Add(entry);
+            if (string.IsNullOrEmpty(name)) { entry["status"] = "error"; entry["error"] = "step missing 'action'"; stopReason = "error"; break; }
+
+            if (step.TryGetValue("expect_state_version", out var ev) && ev.ValueKind == JsonValueKind.Number &&
+                ev.GetInt64() != Convert.ToInt64(current["state_version"]))
+            {
+                entry["status"] = "error";
+                entry["error"] = $"expect_state_version {ev.GetInt64()} != current {current["state_version"]}";
+                stopReason = "stale_state_version"; break;
+            }
+            if (step.TryGetValue("expect_state_type", out var et) && et.ValueKind == JsonValueKind.String &&
+                et.GetString() != current["state_type"] as string)
+            {
+                entry["status"] = "error";
+                entry["error"] = $"expect_state_type {et.GetString()} != current {current["state_type"]}";
+                stopReason = "unexpected_state_type"; break;
+            }
+
+            Dictionary<string, object?> actionResult;
+            try
+            {
+                if (name == "menu_select")
+                {
+                    string option = GetString(action, "option") ?? "";
+                    string? seed = GetString(action, "seed");
+                    var captured = action;
+                    actionResult = OnMain(() => RunTrackedAction(name, captured, () => ExecuteMenuSelect(option, seed)));
+                }
+                else
+                {
+                    var captured = action;
+                    actionResult = OnMain(() => RunTrackedAction(name, captured, () => ExecuteAction(name, captured)));
+                }
+            }
+            catch (Exception ex) { actionResult = Error($"{ex.GetType().Name}: {ex.Message}"); }
+            entry["result"] = actionResult;
+
+            var after = EvalWaitSettled(waitMs, stableMs, includeState: false);
+            bool changed = !Equals(after["state_fingerprint"], current["state_fingerprint"]);
+            entry["state_version_after"] = after["state_version"];
+            entry["state_type_after"] = after["state_type"];
+            entry["changed"] = changed;
+            entry["settled"] = after["settled"];
+            entry["waited_ms"] = after["waited_ms"];
+            current = after;
+
+            if ((string?)actionResult.GetValueOrDefault("status") != "ok")
+            {
+                entry["status"] = "error"; stopReason = "error"; break;
+            }
+            if (!changed)
+            {
+                entry["status"] = "no_change";
+                if (stopOnNoChange) { stopReason = "no_change"; break; }
+                continue;
+            }
+            entry["status"] = "ok";
+            if (!(bool)(after["settled"] ?? false)) { stopReason = "unsettled"; break; }
+        }
+
+        var final = EvalWaitSettled(0, 0, includeState);
+        int ok = results.Count(r => (string?)r.GetValueOrDefault("status") == "ok");
+        return new Dictionary<string, object?>
+        {
+            ["status"] = stopReason switch { "completed" => "ok", "no_change" => "no_change", "unsettled" => "partial", _ => "error" },
+            ["stop_reason"] = stopReason,
+            ["steps_requested"] = steps.Count,
+            ["steps_executed"] = results.Count,
+            ["steps_ok"] = ok,
+            ["steps"] = results,
+            ["snapshot"] = final,
+        };
+    }
+
+    // ------------------------------------------------------------------ helpers
+
+    private static int ParseQueryInt(HttpListenerRequest request, string key, int dflt, int min, int max)
+    {
+        var raw = request.QueryString[key];
+        if (raw == null || !int.TryParse(raw, out int v)) return dflt;
+        return Math.Clamp(v, min, max);
+    }
+
+    private static string? GetString(Dictionary<string, JsonElement> data, string key) =>
+        data.TryGetValue(key, out var e) && e.ValueKind == JsonValueKind.String ? e.GetString() : null;
+
+    private static int GetInt(Dictionary<string, JsonElement> data, string key, int dflt, int min, int max)
+    {
+        if (!data.TryGetValue(key, out var e) || e.ValueKind != JsonValueKind.Number || !e.TryGetInt32(out int v)) return dflt;
+        return Math.Clamp(v, min, max);
+    }
+
+    private static bool GetBool(Dictionary<string, JsonElement> data, string key, bool dflt)
+    {
+        if (!data.TryGetValue(key, out var e)) return dflt;
+        return e.ValueKind switch { JsonValueKind.True => true, JsonValueKind.False => false, _ => dflt };
+    }
+}
