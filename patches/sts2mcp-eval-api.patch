+    // ------------------------------------------------------------------ start_run
+
+    private sealed class StartRunCtx
+    {
+        public string Character = "";
+        public int Ascension;
+        public string? Seed;
+        public bool Custom;
+        public List<string> ModifierIds = new();
+        public List<ModifierModel>? Modifiers;
+        public bool AbandonExisting;
+        public bool Embarked;
+        public bool ModifiersSet;
+        public List<string> Steps = new();
+        public int Clicks;
+    }
+
+    private enum StepOutcome { Continue, Done, Fail }
+
+    private static Dictionary<string, object?> EvalStartRun(Dictionary<string, JsonElement> data)
+    {
+        var ctx = new StartRunCtx();
+        ctx.Character = (GetString(data, "character") ?? "").Trim().ToUpperInvariant();
+        if (ctx.Character.StartsWith("CHARACTER.")) ctx.Character = ctx.Character["CHARACTER.".Length..];
+        if (ctx.Character.Length == 0) return Error("start_run requires 'character' (e.g. IRONCLAD)");
+        var knownCharacters = OnMain(() => ModelDb.AllCharacters.Select(c => c.Id.Entry.ToUpperInvariant()).ToList());
+        if (!knownCharacters.Contains(ctx.Character))
+            return Error($"Unknown character '{ctx.Character}'. Known: {string.Join(", ", knownCharacters)}");
+        if (!data.TryGetValue("ascension", out var ascElem) || ascElem.ValueKind != JsonValueKind.Number || !ascElem.TryGetInt32(out ctx.Ascension))
+            return Error("start_run requires integer 'ascension' (0-10)");
+        if (ctx.Ascension < 0 || ctx.Ascension > 10) return Error($"ascension {ctx.Ascension} out of range 0-10");
+        string mode = (GetString(data, "mode") ?? "standard").Trim().ToLowerInvariant();
+        if (mode != "standard" && mode != "custom") return Error("mode must be 'standard' or 'custom'");
+        ctx.Custom = mode == "custom";
+        string? seed = GetString(data, "seed");
+        if (!string.IsNullOrWhiteSpace(seed))
+        {
+            var canonical = MegaCrit.Sts2.Core.Helpers.SeedHelper.CanonicalizeSeed(seed.Trim());
+            if (canonical.Length == 0 || canonical.Any(ch => !SeedAlphabet.Contains(ch)))
+                return Error($"Invalid seed '{seed}': use characters 0-9 A-Z (O/I map to 0/1)");
+            ctx.Seed = canonical;
+        }
+        else if (GetBool(data, "require_seed", true))
+        {
+            return Error("start_run requires 'seed' for reproducible evaluation (pass require_seed=false for a random seed)");
+        }
+        if (data.TryGetValue("modifiers", out var mods) && mods.ValueKind == JsonValueKind.Array)
+        {
+            foreach (var m in mods.EnumerateArray())
+                if (m.ValueKind == JsonValueKind.String && !string.IsNullOrWhiteSpace(m.GetString()))
+                    ctx.ModifierIds.Add(m.GetString()!.Trim().ToUpperInvariant());
+        }
+        if (ctx.ModifierIds.Count > 0 && !ctx.Custom) return Error("modifiers require mode='custom' (standard runs have none)");
+        ctx.AbandonExisting = GetBool(data, "abandon_existing", false);
+        int timeoutMs = GetInt(data, "timeout_ms", 90000, 5000, 300000);
+
+        if (ctx.Custom && ctx.ModifierIds.Count > 0)
+        {
+            var built = OnMain(() => BuildModifiers(ctx.ModifierIds));
+            if (built.error != null) return Error(built.error);
+            ctx.Modifiers = built.list;
+        }
+
+        Dictionary<string, object?>? settingsResult = null;
+        if (data.TryGetValue("settings", out var settingsElem) && settingsElem.ValueKind == JsonValueKind.Object)
+        {
+            var settings = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(settingsElem.GetRawText())!;
+            settingsResult = OnMain(() => ApplyEvalSettings(settings));
+            if ((string?)settingsResult["status"] != "ok") return settingsResult;
+        }
+
+        // A run already in progress is never silently replaced.
+        bool inRun = OnMain(() => RunManager.Instance.IsInProgress);
+        Dictionary<string, object?>? abandoned = null;
+        if (inRun)
+        {
+            if (!ctx.AbandonExisting)
+                return Error("A run is already in progress. Call abandon first or pass abandon_existing=true.");
+            abandoned = EvalAbandon(new Dictionary<string, JsonElement>());
+            if ((string?)abandoned["status"] != "ok") return abandoned;
+        }
+
+        var start = DateTime.UtcNow;
+        var deadline = start.AddMilliseconds(timeoutMs);
+        string? failure = null;
+        while (DateTime.UtcNow < deadline)
+        {
+            var (outcome, message) = OnMain(() => StartRunStep(ctx));
+            if (message != null && (ctx.Steps.Count == 0 || ctx.Steps[^1] != message)) ctx.Steps.Add(message);
+            if (outcome == StepOutcome.Done) break;
+            if (outcome == StepOutcome.Fail) { failure = message; break; }
+            Thread.Sleep(120);
+        }
+        if (failure != null)
+            return new Dictionary<string, object?> { ["status"] = "error", ["error"] = failure, ["steps"] = ctx.Steps };
+        if (!OnMain(() => RunManager.Instance.IsInProgress))
+            return new Dictionary<string, object?> { ["status"] = "error", ["error"] = $"Run did not start within {timeoutMs} ms", ["steps"] = ctx.Steps };
+
+        OnMain(() => { ResetCardUids(); return true; });
+        var remaining = Math.Max(1000, (int)(deadline - DateTime.UtcNow).TotalMilliseconds);
+        var snapshot = EvalWaitSettled(Math.Min(remaining, 30000), 300, includeState: false);
+        var readback = OnMain(BuildEvalRunInfo);
+
+        var mismatches = new List<string>();
+        if (!string.Equals(readback["character"] as string, ctx.Character, StringComparison.OrdinalIgnoreCase))
+            mismatches.Add($"character: requested {ctx.Character}, got {readback["character"]}");
+        if (readback["ascension"] is not int asc || asc != ctx.Ascension)
+            mismatches.Add($"ascension: requested {ctx.Ascension}, got {readback["ascension"]}");
+        if (ctx.Seed != null && !string.Equals(readback["seed"] as string, ctx.Seed, StringComparison.Ordinal))
+            mismatches.Add($"seed: requested {ctx.Seed}, got {readback["seed"]}");
+        if ((readback["game_mode"] as string) != mode)
+            mismatches.Add($"game_mode: requested {mode}, got {readback["game_mode"]}");
+        var gotMods = (readback["modifiers"] as List<string>) ?? new List<string>();
+        var wantMods = ctx.Modifiers?.Select(DescribeModifier).ToList() ?? new List<string>();
+        if (!gotMods.OrderBy(x => x).SequenceEqual(wantMods.OrderBy(x => x)))
+            mismatches.Add($"modifiers: requested [{string.Join(",", wantMods)}], got [{string.Join(",", gotMods)}]");
+
+        var verified = mismatches.Count == 0;
+        Log.Info($"[STS2 MCP eval] start_run {ctx.Character} A{ctx.Ascension} seed={ctx.Seed ?? "random"} mode={mode} verified={verified} readback_seed={readback["seed"]} readback_asc={readback["ascension"]}");
+        return new Dictionary<string, object?>
+        {
+            ["status"] = verified ? "ok" : "error",
+            ["error"] = verified ? null : "Run started but readback does not match the request: " + string.Join("; ", mismatches),
+            ["verified"] = verified,
+            ["requested"] = new Dictionary<string, object?>
+            {
+                ["character"] = ctx.Character, ["ascension"] = ctx.Ascension, ["seed"] = ctx.Seed,
+                ["mode"] = mode, ["modifiers"] = wantMods
+            },
+            ["readback"] = readback,
+            ["mismatches"] = mismatches,
+            ["seed_mechanism"] = ctx.Custom ? "StartRunLobby.SetSeed (custom)" : (ctx.Seed == null ? "random" : "NGame.DebugSeedOverride (standard)"),
+            ["settings"] = settingsResult?["settings"] ?? OnMain(SafeReadSettings),
+            ["abandoned_previous"] = abandoned?["run_result"],
+            ["steps"] = ctx.Steps,
+            ["elapsed_ms"] = (int)(DateTime.UtcNow - start).TotalMilliseconds,
+            ["state_version"] = snapshot["state_version"],
+            ["state_type"] = snapshot["state_type"],
+            ["settled"] = snapshot["settled"],
+        };
+    }
+
+    private static (List<ModifierModel>? list, string? error) BuildModifiers(List<string> ids)
+    {
+        var all = ModelDb.GoodModifiers.Concat(ModelDb.BadModifiers).ToList();
+        var list = new List<ModifierModel>();
+        var canon = new List<ModifierModel>();
+        foreach (var raw in ids)
+        {
+            var parts = raw.Split(':', 2);
+            var id = parts[0];
+            var model = all.FirstOrDefault(m => string.Equals(m.Id.Entry, id, StringComparison.OrdinalIgnoreCase));
+            if (model == null)
+                return (null, $"Unknown modifier '{id}'. Available: {string.Join(", ", all.Select(m => m.Id.Entry).Distinct())}");
+            if (model is not CharacterCards && canon.Contains(model))
+                return (null, $"Duplicate modifier '{id}'");
+            var mutable = model.ToMutable();
+            if (mutable is CharacterCards cc)
+            {
+                if (parts.Length < 2) return (null, $"{id} needs a character, e.g. {id}:SILENT");
+                var ch = ModelDb.AllCharacters.FirstOrDefault(c => string.Equals(c.Id.Entry, parts[1], StringComparison.OrdinalIgnoreCase));
+                if (ch == null) return (null, $"Unknown character '{parts[1]}' for {id}");
+                cc.CharacterModel = ch.Id;
+            }
+            else if (parts.Length > 1) return (null, $"Modifier '{id}' takes no argument");
+            canon.Add(model);
+            list.Add(mutable);
+        }
+        foreach (var set in ModelDb.MutuallyExclusiveModifiers)
+        {
+            var hit = canon.Where(set.Contains).Select(m => m.Id.Entry).Distinct().ToList();
+            if (hit.Count > 1) return (null, $"Mutually exclusive modifiers: {string.Join(", ", hit)}");
+        }
+        return (list, null);
+    }
+
+    // Main thread. One navigation step towards a started run.
+    private static (StepOutcome, string?) StartRunStep(StartRunCtx ctx)
+    {
+        var tree = Engine.GetMainLoop() as SceneTree;
+        if (tree?.Root == null) return (StepOutcome.Continue, "waiting for scene tree");
+        var game = NGame.Instance;
+        bool transitioning = game?.Transition != null && game.Transition.InTransition;
+
+        if (ctx.Embarked)
+        {
+            if (RunManager.Instance.IsInProgress && NRun.Instance != null && !transitioning)
+                return (StepOutcome.Done, "run loaded");
+            return (StepOutcome.Continue, "waiting for run to load");
+        }
+        if (transitioning) return (StepOutcome.Continue, "waiting for transition");
+        if (RunManager.Instance.IsInProgress && !RunManager.Instance.IsGameOver)
+            return (StepOutcome.Fail, "A run is in progress; cannot start a new one");
+        if (++ctx.Clicks > 60) return (StepOutcome.Fail, "start_run made too many menu steps without starting a run");
+
+        var gameOver = NOverlayStack.Instance?.Peek() as NGameOverScreen ?? FindAll<NGameOverScreen>(tree.Root).FirstOrDefault(IsNodeVisible);
+        if (gameOver != null)
+        {
+            TryCaptureRunResult();
+            return StepFromMenu("main_menu", "game over -> main menu");
+        }
+        var tutorial = FindVisibleAcceptTutorialsFtue(tree.Root);
+        if (tutorial != null && IsFtueNodeActive(tutorial))
+            return StepFromMenu("no", "declined tutorials prompt");
+        if (FindVisibleGenericFtue(tree.Root) != null)
+            return StepFromMenu("advance", "dismissed tutorial popup");
+        if (FindVisibleVerticalPopup(tree.Root) != null || GetVisiblePopupButtonOptions(tree.Root).Count > 0)
+            return (StepOutcome.Fail, "An unexpected modal popup is open; resolve it via /api/v1/singleplayer menu_select first");
+        var timeline = FindFirst<NTimelineScreen>(tree.Root);
+        if (timeline != null && IsNodeVisible(timeline))
+        {
+            var pending = SafePendingEpochs();
+            return (StepOutcome.Fail, pending.Count > 0
+                ? $"Timeline screen is open with unrevealed epochs [{string.Join(",", pending)}]; reveal them manually (not automated)"
+                : "Timeline screen is open; go back to the main menu first");
+        }
+
+        var custom = FindFirst<NCustomRunScreen>(tree.Root);
+        if (custom != null && IsNodeVisible(custom))
+        {
+            if (!ctx.Custom) return ClickField(custom, "_backButton", "custom screen -> back (standard requested)");
+            return CustomRunStep(custom, ctx);
+        }
+        var charSelect = FindFirst<NCharacterSelectScreen>(tree.Root);
+        if (charSelect != null && IsNodeVisible(charSelect))
+        {
+            if (ctx.Custom) return ClickField(charSelect, "_backButton", "character select -> back (custom requested)");
+            return StandardRunStep(charSelect, ctx);
+        }
+        var mainMenu = FindFirst<NMainMenu>(tree.Root);
+        if (mainMenu == null) return (StepOutcome.Continue, "waiting for main menu");
+        var sp = FindFirst<NSingleplayerSubmenu>(tree.Root);
+        if (sp != null && IsNodeVisible(sp))
+            return StepFromMenu(ctx.Custom ? "custom" : "standard", $"singleplayer -> {(ctx.Custom ? "custom" : "standard")}");
+        if (SaveManager.Instance.HasRunSave)
+        {
+            if (!ctx.AbandonExisting)
+                return (StepOutcome.Fail, "A saved run exists (main menu shows Continue). Pass abandon_existing=true to abandon it, or checkpoint_restore/continue it.");
+            mainMenu.RefreshButtons();
+            RecordSavedRunAbandon();
+            mainMenu.AbandonRun();
+            return (StepOutcome.Continue, "abandoned saved run from main menu");
+        }
+        return StepFromMenu("singleplayer", "main menu -> singleplayer");
+    }
+
+    private static (StepOutcome, string?) StepFromMenu(string option, string label)
+    {
+        var r = ExecuteMenuSelect(option);
+        if ((string?)r["status"] == "ok") return (StepOutcome.Continue, label);
+        return (StepOutcome.Continue, $"{label}: {r.GetValueOrDefault("error")} (retrying)");
+    }
+
+    private static (StepOutcome, string?) ClickField(object owner, string field, string label)
+    {
+        if (GetInstanceFieldValue(owner, field) is NClickableControl c && c.IsEnabled)
+        {
+            c.ForceClick();
+            return (StepOutcome.Continue, label);
+        }
+        return (StepOutcome.Continue, $"{label}: control not ready (retrying)");
+    }
+
+    private static string? SelectCharacterAndAscension(Node screen, StartRunLobby? lobby, StartRunCtx ctx, out bool acted)
+    {
+        acted = false;
+        if (lobby == null) return null;
+        var buttons = FindAll<NCharacterSelectButton>(screen);
+        var btn = buttons.FirstOrDefault(b => b.Character != null && string.Equals(b.Character.Id.Entry, ctx.Character, StringComparison.OrdinalIgnoreCase));
+        if (btn == null)
+            return $"Character '{ctx.Character}' not found. Unlocked: {string.Join(", ", buttons.Where(b => !b.IsLocked).Select(b => b.Character?.Id.Entry))}";
+        if (btn.IsLocked)
+            return $"Character '{ctx.Character}' is locked on this profile. Unlocked: {string.Join(", ", buttons.Where(b => !b.IsLocked).Select(b => b.Character?.Id.Entry))}";
+        if (!string.Equals(lobby.LocalPlayer.character?.Id.Entry, ctx.Character, StringComparison.OrdinalIgnoreCase))
+        {
+            btn.Select();
+            acted = true;
+            return null;
+        }
+        if (ctx.Ascension > lobby.MaxAscension)
+            return $"Ascension {ctx.Ascension} is not unlocked for {ctx.Character} (max unlocked: {lobby.MaxAscension})";
+        if (lobby.Ascension != ctx.Ascension)
+        {
+            if (GetInstanceFieldValue(screen, "_ascensionPanel") is NAscensionPanel panel)
+                panel.SetAscensionLevel(ctx.Ascension);
+            if (lobby.Ascension != ctx.Ascension)
+                lobby.SyncAscensionChange(ctx.Ascension);
+            acted = true;
+        }
+        return null;
+    }
+
+    private static (StepOutcome, string?) StandardRunStep(NCharacterSelectScreen charSelect, StartRunCtx ctx)
+    {
+        var lobby = charSelect.Lobby;
+        if (lobby == null) return (StepOutcome.Continue, "waiting for lobby");
+        var err = SelectCharacterAndAscension(charSelect, lobby, ctx, out bool acted);
+        if (err != null) return (StepOutcome.Fail, err);
+        if (acted) return (StepOutcome.Continue, $"selected {ctx.Character} / A{ctx.Ascension}");
+        if (lobby.Ascension != ctx.Ascension) return (StepOutcome.Continue, "waiting for ascension");
+        var r = ExecuteCharacterSelectMenuOption(charSelect, "embark", ctx.Seed);
+        if ((string?)r["status"] != "ok") return (StepOutcome.Continue, $"embark: {r.GetValueOrDefault("error")} (retrying)");
+        ctx.Embarked = true;
+        return (StepOutcome.Continue, $"embarked standard {ctx.Character} A{ctx.Ascension} seed={ctx.Seed ?? "random"}");
+    }
+
+    private static (StepOutcome, string?) CustomRunStep(NCustomRunScreen screen, StartRunCtx ctx)
+    {
+        var lobby = screen.Lobby;
+        if (lobby == null) return (StepOutcome.Continue, "waiting for lobby");
+        var err = SelectCharacterAndAscension(screen, lobby, ctx, out bool acted);
+        if (err != null) return (StepOutcome.Fail, err);
+        if (acted) return (StepOutcome.Continue, $"selected {ctx.Character} / A{ctx.Ascension}");
+        if (!ctx.ModifiersSet)
+        {
+            lobby.SetModifiers(ctx.Modifiers ?? new List<ModifierModel>());
+            ctx.ModifiersSet = true;
+            return (StepOutcome.Continue, $"set modifiers [{string.Join(",", ctx.ModifierIds)}]");
+        }
+        if (NGame.Instance != null) NGame.Instance.DebugSeedOverride = null;
+        if (lobby.Seed != ctx.Seed)
+        {
+            lobby.SetSeed(ctx.Seed);
+            if (GetInstanceFieldValue(screen, "_seedInput") is LineEdit input) input.Text = ctx.Seed ?? "";
+            return (StepOutcome.Continue, $"set seed {ctx.Seed ?? "random"}");
+        }
+        if (GetInstanceFieldValue(screen, "_confirmButton") is NClickableControl confirm && confirm.IsEnabled)
+        {
+            confirm.ForceClick();
+            ctx.Embarked = true;
+            return (StepOutcome.Continue, $"embarked custom {ctx.Character} A{ctx.Ascension} seed={ctx.Seed ?? "random"}");
+        }
+        return (StepOutcome.Continue, "waiting for custom confirm button");
+    }
