+    // ------------------------------------------------------------------ settings
+
+    private static void EnsureEnvSettingsApplied()
+    {
+        if (_evalEnvSettingsApplied) return;
+        _evalEnvSettingsApplied = true;
+        string? raw = System.Environment.GetEnvironmentVariable("STS2_MCP_EVAL_SETTINGS");
+        if (string.IsNullOrWhiteSpace(raw)) return;
+        try
+        {
+            var data = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(raw);
+            if (data == null) return;
+            var result = OnMain(() => ApplyEvalSettings(data));
+            GD.Print($"[STS2 MCP] eval settings from STS2_MCP_EVAL_SETTINGS: status={result["status"]} error={result.GetValueOrDefault("error")}");
+        }
+        catch (Exception ex) { GD.PrintErr($"[STS2 MCP] STS2_MCP_EVAL_SETTINGS ignored: {ex.Message}"); }
+    }
+
+    private static Dictionary<string, object?> SafeReadSettings()
+    {
+        try
+        {
+            var prefs = SaveManager.Instance.PrefsSave;
+            return new Dictionary<string, object?>
+            {
+                ["fast_mode"] = prefs.FastMode.ToString().ToLowerInvariant(),
+                ["screenshake"] = prefs.ScreenShakeOptionIndex,
+                ["text_effects"] = prefs.TextEffectsEnabled,
+                ["tutorials_enabled"] = SaveManager.Instance.Progress?.EnableFtues,
+                ["applied_by_eval"] = _evalSettingsApplied.Count == 0 ? null : new Dictionary<string, object?>(_evalSettingsApplied),
+            };
+        }
+        catch (Exception ex) { return new Dictionary<string, object?> { ["error"] = ex.Message }; }
+    }
+
+    // Main thread. Presentation settings only; none of them is read by game logic or RNG.
+    private static Dictionary<string, object?> ApplyEvalSettings(Dictionary<string, JsonElement> data)
+    {
+        var prefs = SaveManager.Instance.PrefsSave;
+        var changed = new List<string>();
+        if (data.TryGetValue("fast_mode", out var fm) && fm.ValueKind == JsonValueKind.String)
+        {
+            string v = (fm.GetString() ?? "").Trim().ToLowerInvariant();
+            FastModeType mode;
+            switch (v)
+            {
+                case "normal": mode = FastModeType.Normal; break;
+                case "fast": mode = FastModeType.Fast; break;
+                case "instant":
+                    if (!GetBool(data, "allow_experimental", false))
+                        return Error("fast_mode=instant skips engine waits (dev-only; the game resets it to fast at startup). Pass allow_experimental=true to use it.");
+                    mode = FastModeType.Instant; break;
+                default: return Error($"Unknown fast_mode '{v}'. Use: normal, fast, instant (experimental)");
+            }
+            prefs.FastMode = mode;
+            _evalSettingsApplied["fast_mode"] = v;
+            changed.Add("fast_mode");
+        }
+        if (data.TryGetValue("screenshake", out var ss) && ss.ValueKind == JsonValueKind.Number && ss.TryGetInt32(out int shake))
+        {
+            if (shake < 0 || shake > 4) return Error("screenshake must be an option index 0-4 (0 = off)");
+            prefs.ScreenShakeOptionIndex = shake;
+            try { NGame.Instance?.SetScreenshakeMultiplier(MegaCrit.Sts2.Core.Nodes.Screens.Settings.NScreenshakePaginator.GetShakeMultiplier(shake)); } catch { }
+            _evalSettingsApplied["screenshake"] = shake;
+            changed.Add("screenshake");
+        }
+        if (data.TryGetValue("text_effects", out var te) && (te.ValueKind == JsonValueKind.True || te.ValueKind == JsonValueKind.False))
+        {
+            prefs.TextEffectsEnabled = te.GetBoolean();
+            _evalSettingsApplied["text_effects"] = te.GetBoolean();
+            changed.Add("text_effects");
+        }
+        if (data.TryGetValue("skip_tutorials", out var sk) && (sk.ValueKind == JsonValueKind.True || sk.ValueKind == JsonValueKind.False))
+        {
+            // Writes progress.save (EnableFtues only gates tutorial popups; run logic ignores it).
+            SaveManager.Instance.SetFtuesEnabled(!sk.GetBoolean());
+            _evalSettingsApplied["skip_tutorials"] = sk.GetBoolean();
+            changed.Add("skip_tutorials");
+        }
+        bool persist = GetBool(data, "persist", false);
+        if (persist && changed.Count > 0) SaveManager.Instance.SavePrefsFile();
+        if (changed.Count > 0)
+            Log.Info($"[STS2 MCP eval] settings applied: {string.Join(",", changed)} persist={persist}");
+        return new Dictionary<string, object?>
+        {
+            ["status"] = "ok",
+            ["changed"] = changed,
+            ["persisted_to_prefs_save"] = persist,
+            ["settings"] = SafeReadSettings(),
+            ["logic_impact"] = new Dictionary<string, object?>
+            {
+                ["fast_mode"] = "presentation timing only (tween/VFX waits); VFX randomness uses the non-gameplay chaotic RNG. 'instant' also skips Cmd.Wait and is experimental.",
+                ["screenshake"] = "camera only",
+                ["text_effects"] = "rich-text animation only",
+                ["skip_tutorials"] = "tutorial popups only (progress.save EnableFtues); run generation and rules ignore it",
+            }
+        };
+    }
