+    // Adds stable references to the state in place and returns a compact ref table.
+    private static Dictionary<string, object?> AnnotateStableRefs(Dictionary<string, object?> state)
+    {
+        var refs = new Dictionary<string, object?>();
+        var run = RunManager.Instance.DebugOnlyGetState();
+        var player = run == null ? null : LocalContext.GetMe(run);
+        if (player == null) return refs;
+
+        var deck = new List<Dictionary<string, object?>>();
+        var deckIndex = new Dictionary<CardModel, int>(ReferenceEqualityComparer.Instance);
+        int i = 0;
+        foreach (var card in player.Deck.Cards)
+        {
+            deckIndex[card] = i;
+            deck.Add(new Dictionary<string, object?>
+            {
+                ["deck_index"] = i++, ["uid"] = CardUid(card, isDeck: true), ["id"] = card.Id.Entry, ["upgraded"] = card.IsUpgraded
+            });
+        }
+        refs["deck"] = deck;
+        refs["relics"] = player.Relics.Select((r, idx) => new Dictionary<string, object?> { ["index"] = idx, ["id"] = r.Id.Entry }).ToList();
+        refs["potions"] = player.PotionSlots.Select((p, idx) => new Dictionary<string, object?> { ["slot"] = idx, ["id"] = p?.Id.Entry }).ToList();
+
+        var pc = player.PlayerCombatState;
+        if (pc != null && CombatManager.Instance.IsInProgress)
+        {
+            var hand = new List<Dictionary<string, object?>>();
+            int hi = 0;
+            List<Dictionary<string, object?>>? handState = null;
+            if (state.TryGetValue("player", out var p) && p is Dictionary<string, object?> pd && pd.TryGetValue("hand", out var h))
+                handState = h as List<Dictionary<string, object?>>;
+            foreach (var card in pc.Hand.Cards)
+            {
+                string uid = CardUid(card, isDeck: false);
+                int? dIdx = card.DeckVersion != null && deckIndex.TryGetValue(card.DeckVersion, out var x) ? x : null;
+                hand.Add(new Dictionary<string, object?> { ["index"] = hi, ["card_uid"] = uid, ["id"] = card.Id.Entry, ["deck_index"] = dIdx });
+                if (handState != null && hi < handState.Count)
+                {
+                    handState[hi]["card_uid"] = uid;
+                    handState[hi]["deck_index"] = dIdx;
+                }
+                hi++;
+            }
+            refs["hand"] = hand;
+            if (state.TryGetValue("battle", out var b) && b is Dictionary<string, object?> battle &&
+                battle.TryGetValue("enemies", out var e) && e is List<Dictionary<string, object?>> enemies)
+            {
+                refs["enemies"] = enemies.Select(en => new Dictionary<string, object?>
+                {
+                    ["entity_id"] = en.TryGetValue("entity_id", out var id) ? id : null,
+                    ["combat_id"] = en.TryGetValue("combat_id", out var cid) ? cid : null,
+                }).ToList();
+            }
+        }
+        return refs;
+    }
+
+    private static string CardUid(CardModel card, bool isDeck)
+    {
+        if (CardUids.TryGetValue(card, out var existing)) return existing;
+        string uid;
+        if (!isDeck && card.DeckVersion != null)
+            uid = CardUid(card.DeckVersion, isDeck: true);
+        else
+            uid = isDeck ? $"d{_nextDeckUid++}" : $"g{_nextGenUid++}";
+        CardUids.AddOrUpdate(card, uid);
+        return uid;
+    }
+
+    private static void ResetCardUids()
+    {
+        CardUids.Clear();
+        _nextDeckUid = 0;
+        _nextGenUid = 0;
+    }
