+/// <summary>
+/// Evaluation API (/api/v1/eval). Benchmark-oriented surface on top of the existing
+/// singleplayer endpoint: headless run start with readback, settled snapshots with a
+/// monotonic state_version, lifecycle (abandon / run result), checkpoints, batched
+/// actions with per-step verification and logic-neutral speed settings.
+/// Nothing here changes game rules; run start drives the game's own menu path so RNG
+/// and act selection are identical to a run started by hand.
+/// </summary>
+public static partial class McpMod
+{
+    internal const int EvalSchemaVersion = 1;
+    private const string SeedAlphabet = "0123456789ABCDEFGHJKLMNPQRSTUVWXYZ";
