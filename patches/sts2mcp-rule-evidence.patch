--- /dev/null
+++ b/McpMod.RuleEvidence.cs
@@ -0,0 +1,94 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Security.Cryptography;
+using MegaCrit.Sts2.Core.Debug;
+using MegaCrit.Sts2.Core.Entities.Cards;
+using MegaCrit.Sts2.Core.Hooks;
+using MegaCrit.Sts2.Core.Localization.DynamicVars;
+using MegaCrit.Sts2.Core.Models;
+
+namespace STS2_MCP;
+
+public static partial class McpMod
+{
+    private static readonly Lazy<string?> RulesAssemblySha = new(() =>
+    {
+        try
+        {
+            using var stream = File.OpenRead(typeof(CardModel).Assembly.Location);
+            return Convert.ToHexString(SHA256.HashData(stream)).ToLowerInvariant();
+        }
+        catch { return null; }
+    });
+
+    private static Dictionary<string, object?> BuildRulesContext()
+    {
+        var release = ReleaseInfoManager.Instance.ReleaseInfo;
+        return new Dictionary<string, object?>
+        {
+            ["schema_version"] = 1,
+            ["game_version"] = release?.Version,
+            ["game_commit"] = release?.Commit,
+            ["game_assembly_sha256"] = RulesAssemblySha.Value,
+            ["source_priority"] = "live_engine_preview > matching_game_rules > community_reference",
+            ["limitations"] = "Previews are not action simulations. Other gameplay mods can change rules. No RNG or hidden draw order exported."
+        };
+    }
+
+    private static Dictionary<string, object?> BuildCardRulePreview(CardModel card)
+    {
+        var variables = new List<Dictionary<string, object?>>();
+        foreach (var pair in card.DynamicVars)
+        {
+            var value = pair.Value;
+            var item = new Dictionary<string, object?>
+            {
+                ["name"] = pair.Key, ["type"] = value.GetType().Name,
+                ["base_value"] = value.BaseValue,
+                ["coverage"] = "variable_only; read_card_rules_for_trigger_and_repeats"
+            };
+            try
+            {
+                // Mirror the engine's UI hooks without mutating the shared PreviewValue or target.
+                // Only exact built-in variable types are supported; derived/calculated values
+                // may have their own formulas and must not be silently treated as plain damage.
+                if (value.GetType() == typeof(DamageVar) && card.CombatState != null)
+                {
+                    var damage = (DamageVar)value;
+                    item["damage_by_target"] = card.CombatState.HittableEnemies.Select(target =>
+                    {
+                        decimal amount = Hook.ModifyDamage(card.Owner.RunState, card.CombatState,
+                            target, card.Owner.Creature, damage.BaseValue, damage.Props, card,
+                            ModifyDamageHookType.All, CardPreviewMode.Normal, out _);
+                        return new Dictionary<string, object?>
+                        {
+                            ["combat_id"] = target.CombatId,
+                            ["before_block"] = (int)Math.Max(0m, amount),
+                            ["unrounded"] = amount
+                        };
+                    }).ToList();
+                    item["coverage"] = "engine_damage_variable_preview; current_state_single_hit_before_block";
+                }
+                else if (value.GetType() == typeof(BlockVar) && card.CombatState != null)
+                {
+                    var block = (BlockVar)value;
+                    decimal amount = Hook.ModifyBlock(card.CombatState, card.Owner.Creature,
+                        block.BaseValue, block.Props, card, null, out _);
+                    item["block_preview"] = (int)Math.Max(0m, amount);
+                    item["unrounded"] = amount;
+                    item["coverage"] = "engine_block_variable_preview; read_rules_for_trigger";
+                }
+            }
+            catch { item["coverage"] = "unavailable; engine_preview_failed"; }
+            variables.Add(item);
+        }
+        return new Dictionary<string, object?>
+        {
+            ["source"] = "engine_ui_hooks",
+            ["scope"] = "current_state_variables_only; not_complete_card_effects_or_multi_hit_simulation",
+            ["variables"] = variables
+        };
+    }
+}
